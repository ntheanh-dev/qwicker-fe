# Leave blank to use the Expo/Metro host automatically (works on devices on the same Wi-Fi).
# Override with the FULL API base, including /api/v3, for a remote backend.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_API_PORT=8888
# Default: the same host, port 8088, /websocket/ws (direct SockJS service).
EXPO_PUBLIC_WEBSOCKET_URL=
